From: Claude <noreply@anthropic.com>
Date: Thu, 19 Mar 2026 00:00:00 +0000
Subject: [PATCH] Fix build system architecture detection and installation

This patch fixes multiple build system issues for Darwin/XNU:

1. Architecture Detection (configure)
   - Detects Darwin/XNU target triple (*-apple-darwin*, *-apple-macos*)
   - Automatically appends -xnu suffix to ARCH for Darwin targets
   - Example: powerpc becomes powerpc-xnu, x86_64 becomes x86_64-xnu

2. Makefile.xnu Configuration Support
   - Now includes config.mak generated by configure
   - Allows ARCH to be set from config.mak or command line
   - Falls back to x86_64-xnu if ARCH not specified
   - Removes hardcoded ARCH = x86_64-xnu

3. MacPorts DESTROOT Support (Makefile, Makefile.xnu)
   - DESTROOT is an alias for DESTDIR
   - Takes precedence if both are set
   - Standard MacPorts convention

4. Installation Directory Creation (Makefile, Makefile.xnu)
   - Explicitly creates parent directories before install
   - Fixes compatibility with MacPorts install command override
   - Each install rule now runs mkdir -p before $(INSTALL)

5. Installation Messages (Makefile, Makefile.xnu)
   - Shows installation progress

Signed-off-by: Claude <noreply@anthropic.com>
---
 Makefile     | 28 ++++++++++++++++++++++++++++
 Makefile.xnu | 32 ++++++++++++++++++++++++++++++--
 configure    | 10 ++++++++++
 3 files changed, 68 insertions(+), 2 deletions(-)

diff --git Makefile Makefile
index d2e89979..fc8a6eea 100644
--- Makefile
+++ Makefile
@@ -74,6 +74,12 @@ WRAPCC_CLANG = clang
 
 LDSO_PATHNAME = $(syslibdir)/ld-musl-$(ARCH)$(SUBARCH).so.1
 
+# Support both DESTDIR (standard) and DESTROOT (MacPorts/Darwin)
+# DESTROOT takes precedence if both are set
+ifdef DESTROOT
+DESTDIR = $(DESTROOT)
+endif
+
 -include config.mak
 
 ifeq ($(ARCH),)
@@ -194,36 +200,58 @@ obj/%-clang: $(srcdir)/tools/%-clang.in config.mak
 	chmod +x $@
 
 $(DESTDIR)$(bindir)/%: obj/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D $< $@
 
 $(DESTDIR)$(libdir)/%.so: lib/%.so
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 755 $< $@
 
 $(DESTDIR)$(libdir)/%: lib/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/bits/%: $(srcdir)/arch/$(ARCH)/bits/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/bits/%: $(srcdir)/arch/generic/bits/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/bits/%: obj/include/bits/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/%: $(srcdir)/include/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(LDSO_PATHNAME): $(DESTDIR)$(libdir)/libc.so
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -l $(libdir)/libc.so $@ || true
 
 install-libs: $(ALL_LIBS:lib/%=$(DESTDIR)$(libdir)/%) $(if $(SHARED_LIBS),$(DESTDIR)$(LDSO_PATHNAME),)
+	@echo "Installed libraries to: $(DESTDIR)$(libdir)"
 
 install-headers: $(ALL_INCLUDES:include/%=$(DESTDIR)$(includedir)/%)
+	@echo "Installed headers to: $(DESTDIR)$(includedir)"
 
 install-tools: $(ALL_TOOLS:obj/%=$(DESTDIR)$(bindir)/%)
+	@echo "Installed tools to: $(DESTDIR)$(bindir)"
 
 install: install-libs install-headers install-tools
+	@echo ""
+	@echo "Installation complete!"
+	@echo "  Libraries: $(DESTDIR)$(libdir)"
+	@echo "  Headers:   $(DESTDIR)$(includedir)"
+	@echo "  Tools:     $(DESTDIR)$(bindir)"
+	@echo ""
+	@if [ -n "$(DESTDIR)" ]; then \
+		echo "Note: Files installed to staging directory: $(DESTDIR)"; \
+		echo "      Move them to final location if needed."; \
+		echo ""; \
+	fi
 
 musl-git-%.tar.gz: .git
 	 git --git-dir=$(srcdir)/.git archive --format=tar.gz --prefix=$(patsubst %.tar.gz,%,$@)/ -o $@ $(patsubst musl-git-%.tar.gz,%,$@)
diff --git Makefile.xnu Makefile.xnu
index 096422ab..e0cd390a 100644
--- Makefile.xnu
+++ Makefile.xnu
@@ -2,14 +2,25 @@
 # Makefile for musl-xnu
 #
 
-ARCH = x86_64-xnu
-
 srcdir = .
 
 prefix = /usr
 includedir = $(prefix)/include
 libdir = $(prefix)/lib
 
+# Support both DESTDIR (standard) and DESTROOT (MacPorts)
+# DESTROOT takes precedence if both are set
+ifdef DESTROOT
+DESTDIR = $(DESTROOT)
+endif
+
+-include config.mak
+
+# Default to x86_64-xnu if ARCH not set
+ifeq ($(ARCH),)
+ARCH = x86_64-xnu
+endif
+
 SRC_DIRS = $(addprefix $(srcdir)/,src/* crt example)
 BASE_GLOBS = $(addsuffix /*.c,$(SRC_DIRS))
 ARCH_GLOBS = $(addsuffix /$(ARCH)/*.[csS],$(SRC_DIRS))
@@ -116,25 +127,42 @@ lib/%.o: obj/crt/%.o
 	cp $< $@
 
 $(DESTDIR)$(libdir)/%: lib/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/bits/%: $(srcdir)/arch/$(ARCH)/bits/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/bits/%: $(srcdir)/arch/generic/bits/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/bits/%: obj/include/bits/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 $(DESTDIR)$(includedir)/%: $(srcdir)/include/%
+	mkdir -p $(dir $@)
 	$(INSTALL) -D -m 644 $< $@
 
 install-libs: $(ALL_LIBS:lib/%=$(DESTDIR)$(libdir)/%)
+	@echo "Installed libraries to: $(DESTDIR)$(libdir)"
 
 install-headers: $(ALL_INCLUDES:include/%=$(DESTDIR)$(includedir)/%)
+	@echo "Installed headers to: $(DESTDIR)$(includedir)"
 
 install: install-libs install-headers
+	@echo ""
+	@echo "Installation complete!"
+	@echo "  Libraries: $(DESTDIR)$(libdir)"
+	@echo "  Headers:   $(DESTDIR)$(includedir)"
+	@echo ""
+	@if [ -n "$(DESTDIR)" ]; then \
+		echo "Note: Files installed to staging directory: $(DESTDIR)"; \
+		echo "      Move them to final location if needed."; \
+		echo ""; \
+	fi
 
 kiwi-git-%.tar.gz: .git
 	 git --git-dir=$(srcdir)/.git archive --format=tar.gz --prefix=$(patsubst %.tar.gz,%,$@)/ -o $@ $(patsubst kiwi-git-%.tar.gz,%,$@)
diff --git configure configure
index c2db298c..0daa1d1d 100755
--- configure
+++ configure
@@ -330,6 +330,16 @@ unknown) fail "$0: unable to detect target arch; try $0 --target=..." ;;
 *) fail "$0: unknown or unsupported target \"$target\"" ;;
 esac
 
+#
+# Detect Darwin/XNU and append -xnu suffix to ARCH
+#
+case "$target" in
+*-apple-darwin*|*-apple-macos*)
+printf "Darwin/XNU target detected, using %s-xnu\n" "$ARCH"
+ARCH="$ARCH-xnu"
+;;
+esac
+
 #
 # Try to get a conforming C99 freestanding environment
 #
