diff --git a/arch/powerpc-xnu/bits/setjmp.h b/arch/powerpc-xnu/bits/setjmp.h
new file mode 100644
index 00000000..1be63e07
--- /dev/null
+++ b/arch/powerpc-xnu/bits/setjmp.h
@@ -0,0 +1,12 @@
+/* PowerPC Darwin setjmp buffer layout
+ * Based on MacOSX10.6.sdk/usr/include/ppc/setjmp.h
+ *
+ * jmp_buf saves:
+ * - GPRs r13-r31 (19 registers)
+ * - FPRs f14-f31 (18 registers, each is 8 bytes = 2 words)
+ * - CR, LR, CTR, XER
+ * - Vector registers (if AltiVec enabled)
+ *
+ * Total: at least 70 words for basic context
+ */
+typedef unsigned long __jmp_buf[70];
diff --git a/arch/powerpc-xnu/bits/signal.h b/arch/powerpc-xnu/bits/signal.h
new file mode 100644
index 00000000..9dd13f1c
--- /dev/null
+++ b/arch/powerpc-xnu/bits/signal.h
@@ -0,0 +1,88 @@
+#if defined(_POSIX_SOURCE) || defined(_POSIX_C_SOURCE) \
+ || defined(_XOPEN_SOURCE) || defined(_GNU_SOURCE) || defined(_BSD_SOURCE)
+
+#if defined(_XOPEN_SOURCE) || defined(_GNU_SOURCE) || defined(_BSD_SOURCE)
+#define MINSIGSTKSZ 2048
+#define SIGSTKSZ 8192
+#endif
+
+/* PowerPC Darwin mcontext layout
+ * Based on MacOSX10.6.SDK/usr/include/mach/ppc/_structs.h
+ *
+ * _STRUCT_PPC_THREAD_STATE contains:
+ * - 32 GPRs (r0-r31)
+ * - srr0, srr1 (PC and MSR)
+ * - cr, xer, lr, ctr
+ * - vrsave, mq (optional)
+ *
+ * Plus FPU and vector state
+ * Conservatively allocate 256 words
+ */
+typedef struct {
+	unsigned long __space[256];
+} mcontext_t;
+
+struct sigaltstack {
+	void *ss_sp;
+	size_t ss_size;
+	int ss_flags;
+};
+
+typedef struct __ucontext {
+	int uc_onstack;
+	sigset_t uc_sigmask;
+	struct sigaltstack uc_stack;
+	struct __ucontext *uc_link;
+	size_t uc_mcsize;
+	mcontext_t *uc_mcontext;
+	mcontext_t __mcontext_data;
+} ucontext_t;
