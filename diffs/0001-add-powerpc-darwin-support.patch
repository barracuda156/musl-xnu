new file mode 100644
index 00000000..50e1f681
--- /dev/null
+++ b/src/thread/powerpc64-xnu/__set_thread_area.s
@@ -0,0 +1,26 @@
+/* PowerPC64 Darwin __set_thread_area implementation
+ * Store thread pointer for later retrieval
+ */
+
+	.data
+	.align 3
+	.globl ___pthread_self_ptr
+___pthread_self_ptr:
+	.quad 0
+
+	.text
+	.align 2
+	.globl ___set_thread_area
+___set_thread_area:
+	/* r3 contains the thread pointer */
+	addis 4, 2, ___pthread_self_ptr@toc@ha
+	std 3, ___pthread_self_ptr@toc@l(4)
+	li 3, 0
+	blr
+
+	.globl ___pthread_self_impl
+___pthread_self_impl:
+	/* Load and return the thread pointer */
+	addis 3, 2, ___pthread_self_ptr@toc@ha
+	ld 3, ___pthread_self_ptr@toc@l(3)
+	blr
