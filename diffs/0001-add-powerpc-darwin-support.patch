diff --git a/src/signal/powerpc-xnu/sigset.c b/src/signal/powerpc-xnu/sigset.c
new file mode 100644
index 00000000..0d7b4564
--- /dev/null
+++ b/src/signal/powerpc-xnu/sigset.c
@@ -0,0 +1,27 @@
+#include <signal.h>
+
+void (*sigset(int sig, void (*handler)(int)))(int)
+{
+	struct sigaction sa, sa_old;
+	sigset_t mask;
+
+	sigemptyset(&mask);
+	if (sigaddset(&mask, sig) < 0)
+		return SIG_ERR;
+	
+	if (handler == SIG_HOLD) {
+		if (sigaction(sig, 0, &sa_old) < 0)
+			return SIG_ERR;
+		if (sigprocmask(SIG_BLOCK, &mask, &mask) < 0)
+			return SIG_ERR;
+	} else {
+		sa.sa_handler = handler;
+		sa.sa_flags = 0;
+		sigemptyset(&sa.sa_mask);
+		if (sigaction(sig, &sa, &sa_old) < 0)
+			return SIG_ERR;
+		if (sigprocmask(SIG_UNBLOCK, &mask, &mask) < 0)
+			return SIG_ERR;
+	}
+	return sigismember(&mask, sig) ? SIG_HOLD : sa_old.sa_handler;
+}
diff --git a/src/signal/powerpc-xnu/sigsetjmp.s b/src/signal/powerpc-xnu/sigsetjmp.s
new file mode 100644
index 00000000..1c28ae85
--- /dev/null
+++ b/src/signal/powerpc-xnu/sigsetjmp.s
@@ -0,0 +1,35 @@
+/* PowerPC Darwin siglongjmp implementation */
+
+	.text
+	.align 2
+	.globl _siglongjmp
+	.globl __siglongjmp
+_siglongjmp:
+__siglongjmp:
+	/* Check if signal mask was saved */
+	lwz 5, 240(3)
+	cmpwi 5, 0
+	beq 1f
+
+	/* Restore signal mask - call sigprocmask(SIG_SETMASK, &env->mask, NULL) */
+	mflr 0
+	stwu 1, -32(1)
+	stw 0, 36(1)
+	stw 3, 24(1)     /* Save env */
+	stw 4, 28(1)     /* Save val */
+
+	li 3, 3          /* SIG_SETMASK */
+	lwz 4, 24(1)     /* env */
+	addi 4, 4, 252   /* &env->mask */
+	li 5, 0          /* NULL */
+	bl _sigprocmask
+
+	lwz 3, 24(1)     /* Restore env */
+	lwz 4, 28(1)     /* Restore val */
+	lwz 0, 36(1)
+	mtlr 0
+	addi 1, 1, 32
+
+1:
+	/* Call regular longjmp */
+	b _longjmp
