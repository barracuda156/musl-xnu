diff --git a/src/thread/powerpc-xnu/__set_thread_area.s b/src/thread/powerpc-xnu/__set_thread_area.s
new file mode 100644
index 00000000..12295aa9
--- /dev/null
+++ b/src/thread/powerpc-xnu/__set_thread_area.s
@@ -0,0 +1,26 @@
+/* PowerPC Darwin __set_thread_area implementation
+ * Store thread pointer for later retrieval
+ */
+
+	.data
+	.align 2
+	.globl ___pthread_self_ptr
+___pthread_self_ptr:
+	.long 0
+
+	.text
+	.align 2
+	.globl ___set_thread_area
+___set_thread_area:
+	/* r3 contains the thread pointer */
+	addis 4, 0, ha16(___pthread_self_ptr)
+	stw 3, lo16(___pthread_self_ptr)(4)
+	li 3, 0
+	blr
+
+	.globl ___pthread_self_impl
+___pthread_self_impl:
+	/* Load and return the thread pointer */
+	addis 3, 0, ha16(___pthread_self_ptr)
+	lwz 3, lo16(___pthread_self_ptr)(3)
+	blr
