diff --git a/src/signal/powerpc-xnu/restore.s b/src/signal/powerpc-xnu/restore.s
new file mode 100644
index 00000000..6994d746
--- /dev/null
+++ b/src/signal/powerpc-xnu/restore.s
@@ -0,0 +1,17 @@
+/* PowerPC Darwin signal trampoline
+ * This is called by the kernel after a signal handler returns
+ */
+
+	.text
+	.align 2
+	.globl ___restore_rt
+	.globl ___restore
+___restore_rt:
+___restore:
+	/* Darwin kernel expects us to call sigreturn syscall (SYS_sigreturn = 184)
+	 * The context is already on the stack set up by the kernel */
+	li 0, 184        /* SYS_sigreturn */
+	addis 0, 0, 0x200  /* Add UNIX_SYSCALL flag (0x2000000) */
+	sc
+	/* Should not return, but just in case */
+	blr
