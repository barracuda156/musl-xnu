diff --git a/arch/powerpc-xnu/crt_arch.h b/arch/powerpc-xnu/crt_arch.h
new file mode 100644
index 00000000..361bca08
--- /dev/null
+++ b/arch/powerpc-xnu/crt_arch.h
@@ -0,0 +1,34 @@
+/* PowerPC Darwin program startup
+ * Stack layout on entry:
+ * sp+0: argc
+ * sp+4: argv[0]
+ * ...
+ * sp+4*(argc+1): NULL
+ * sp+4*(argc+2): envp[0]
+ * ...
+ * Apple vector follows environment
+ */
+
+__asm__(
+".data\n"
+".align 2\n"
+"___image_base:\n"
+".long ___mh_execute_header\n"
+"___start_static:\n"
+".long _start\n"
+".text\n"
+".align 2\n"
+".globl _start\n"
+"_start:\n"
+"	li 31, 0\n"              /* Clear frame pointer */
+"	stwu 1, -16(1)\n"        /* Align stack to 16 bytes */
+"	mr 3, 1\n"               /* Pass stack pointer as arg */
+"	addis 4, 0, ha16(___image_base)\n"
+"	lwz 4, lo16(___image_base)(4)\n"  /* Load image base */
+"	addis 5, 0, ha16(_start)\n"
+"	addi 5, 5, lo16(_start)\n"        /* Get start address */
+"	addis 6, 0, ha16(___start_static)\n"
+"	lwz 6, lo16(___start_static)(6)\n"
+"	subf 5, 6, 5\n"                    /* Calculate slide */
+"	bl ___start_c\n"
+);
diff --git a/arch/powerpc-xnu/pthread_arch.h b/arch/powerpc-xnu/pthread_arch.h
new file mode 100644
index 00000000..ea27670e
--- /dev/null
+++ b/arch/powerpc-xnu/pthread_arch.h
@@ -0,0 +1,24 @@
+/* PowerPC Darwin uses r2 for thread-local storage pointer on 32-bit
+ * and r13 for TLS on 64-bit, but for compatibility with musl's
+ * pthread implementation, we use a runtime call to get the thread pointer.
+ */
+
+static inline struct pthread *__pthread_self()
+{
+	struct pthread *self;
+	/* On Darwin PowerPC, thread pointer is not in a fixed register
+	 * accessible from user space. We need to call pthread_self() or
+	 * use Mach thread_self_trap. For musl compatibility, we use a
+	 * global pointer approach set by __set_thread_area */
+	__asm__ __volatile__ (
+		"bl ___pthread_self_impl\n"
+		"mr %0, 3"
+		: "=r"(self)
+		:
+		: "3", "lr", "memory");
+	return self;
+}
+
+#define TP_ADJ(p) (p)
+
+#define MC_PC srr0
