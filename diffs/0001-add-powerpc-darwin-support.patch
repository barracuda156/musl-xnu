+/* PowerPC Darwin floating-point environment
+ * Uses FPSCR (Floating-Point Status and Control Register)
+ */
+
+	.text
+
+	.align 2
+	.globl _fegetround
+_fegetround:
+	mffs 0
+	stfd 0, -8(1)
+	lwz 3, -4(1)
+	rlwinm 3, 3, 0, 30, 31
+	blr
+
+	.align 2
+	.globl ___fesetround
+___fesetround:
+	mffs 0
+	stfd 0, -8(1)
+	lwz 4, -4(1)
+	rlwinm 4, 4, 0, 0, 29
+	or 4, 4, 3
+	stw 4, -4(1)
+	lfd 0, -8(1)
+	mtfsf 255, 0
+	li 3, 0
+	blr
+
+	.align 2
+	.globl _feclearexcept
+_feclearexcept:
+	/* Clear exception flags in FPSCR */
+	mffs 0
+	stfd 0, -8(1)
+	lwz 4, -4(1)
+	andc 4, 4, 3
+	stw 4, -4(1)
+	lfd 0, -8(1)
+	mtfsf 255, 0
+	li 3, 0
+	blr
+
+	.align 2
+	.globl _feraiseexcept
+_feraiseexcept:
+	/* Raise exception flags in FPSCR */
+	mffs 0
+	stfd 0, -8(1)
+	lwz 4, -4(1)
+	or 4, 4, 3
+	stw 4, -4(1)
+	lfd 0, -8(1)
+	mtfsf 255, 0
+	li 3, 0
+	blr
+
+	.align 2
+	.globl _fetestexcept
+_fetestexcept:
+	/* Test exception flags in FPSCR */
+	mffs 0
+	stfd 0, -8(1)
+	lwz 4, -4(1)
+	and 3, 4, 3
+	blr
+
+	.align 2
+	.globl _fegetenv
+_fegetenv:
+	/* Get entire FPSCR */
+	mffs 0
+	stfd 0, 0(3)
+	li 3, 0
+	blr
+
+	.align 2
+	.globl _fesetenv
+_fesetenv:
+	/* Set entire FPSCR */
+	cmpwi 3, -1
+	bne 1f
+	/* FE_DFL_ENV: Reset to default */
+	mtfsfi 7, 0
+	mtfsfi 6, 0
+	mtfsfi 5, 0
+	mtfsfi 4, 0
+	mtfsfi 3, 0
+	mtfsfi 2, 0
+	mtfsfi 1, 0
+	mtfsfi 0, 0
+	li 3, 0
+	blr
+1:
+	lfd 0, 0(3)
+	mtfsf 255, 0
+	li 3, 0
+	blr
