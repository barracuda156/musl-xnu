diff --git a/src/setjmp/powerpc-xnu/longjmp.s b/src/setjmp/powerpc-xnu/longjmp.s
new file mode 100644
index 00000000..d9a8192b
--- /dev/null
+++ b/src/setjmp/powerpc-xnu/longjmp.s
@@ -0,0 +1,77 @@
+/* PowerPC Darwin longjmp implementation
+ * void longjmp(jmp_buf env, int val)
+ * env is in r3, val is in r4
+ *
+ * Restore:
+ * - GPRs r1, r2, r13-r31
+ * - FPRs f14-f31
+ * - CR, LR, CTR
+ * - Non-volatile vector registers (if AltiVec)
+ */
+
+	.text
+	.align 2
+	.globl _longjmp
+	.globl __longjmp
+_longjmp:
+__longjmp:
+	/* Save return value */
+	mr 0, 4
+
+	/* Restore FPRs (f14-f31) */
+	lfd 14, 96(3)
+	lfd 15, 104(3)
+	lfd 16, 112(3)
+	lfd 17, 120(3)
+	lfd 18, 128(3)
+	lfd 19, 136(3)
+	lfd 20, 144(3)
+	lfd 21, 152(3)
+	lfd 22, 160(3)
+	lfd 23, 168(3)
+	lfd 24, 176(3)
+	lfd 25, 184(3)
+	lfd 26, 192(3)
+	lfd 27, 200(3)
+	lfd 28, 208(3)
+	lfd 29, 216(3)
+	lfd 30, 224(3)
+	lfd 31, 232(3)
+
+	/* Restore special registers */
+	lwz 5, 84(3)     /* LR */
+	mtlr 5
+	lwz 5, 88(3)     /* CR */
+	mtcr 5
+	lwz 5, 92(3)     /* CTR */
+	mtctr 5
+
+	/* Restore GPRs */
+	lwz 1, 0(3)      /* r1 (SP) */
+	lwz 2, 4(3)      /* r2 (TOC/reserved) */
+	lwz 13, 8(3)     /* r13 */
+	lwz 14, 12(3)    /* r14 */
+	lwz 15, 16(3)    /* r15 */
+	lwz 16, 20(3)    /* r16 */
+	lwz 17, 24(3)    /* r17 */
+	lwz 18, 28(3)    /* r18 */
+	lwz 19, 32(3)    /* r19 */
+	lwz 20, 36(3)    /* r20 */
+	lwz 21, 40(3)    /* r21 */
+	lwz 22, 44(3)    /* r22 */
+	lwz 23, 48(3)    /* r23 */
+	lwz 24, 52(3)    /* r24 */
+	lwz 25, 56(3)    /* r25 */
+	lwz 26, 60(3)    /* r26 */
+	lwz 27, 64(3)    /* r27 */
+	lwz 28, 68(3)    /* r28 */
+	lwz 29, 72(3)    /* r29 */
+	lwz 30, 76(3)    /* r30 */
+	lwz 31, 80(3)    /* r31 */
+
+	/* Set return value (r3) - ensure it's not 0 */
+	mr 3, 0
+	cmpwi 3, 0
+	bnelr
+	li 3, 1
+	blr
diff --git a/src/setjmp/powerpc-xnu/setjmp.s b/src/setjmp/powerpc-xnu/setjmp.s
