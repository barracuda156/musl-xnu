diff --git a/arch/powerpc64-xnu/crt_arch.h b/arch/powerpc64-xnu/crt_arch.h
new file mode 100644
index 00000000..973236a3
--- /dev/null
+++ b/arch/powerpc64-xnu/crt_arch.h
@@ -0,0 +1,36 @@
+/* PowerPC64 Darwin program startup
+ * Stack layout on entry (64-bit):
+ * sp+0: argc
+ * sp+8: argv[0]
+ * ...
+ * sp+8*(argc+1): NULL
+ * sp+8*(argc+2): envp[0]
+ * ...
+ * Apple vector follows environment
+ */
+
+__asm__(
+".data\n"
+".align 3\n"
+"___image_base:\n"
+".quad ___mh_execute_header\n"
+"___start_static:\n"
+".quad _start\n"
+".text\n"
+".align 3\n"
+".globl _start\n"
+"_start:\n"
+"	li 31, 0\n"              /* Clear frame pointer */
+"	stdu 1, -32(1)\n"        /* Align stack to 16 bytes */
+"	mr 3, 1\n"               /* Pass stack pointer as arg */
+"	ld 4, ___image_base@got(2)\n"  /* Load image base (TOC-relative) */
+"	addis 5, 0, _start@highest\n"
+"	ori 5, 5, _start@higher\n"
+"	rldicr 5, 5, 32, 31\n"
+"	oris 5, 5, _start@h\n"
+"	ori 5, 5, _start@l\n"    /* Get start address */
+"	ld 6, ___start_static@got(2)\n"
+"	subf 5, 6, 5\n"          /* Calculate slide */
+"	bl ___start_c\n"
+"	nop\n"
+);
diff --git a/arch/powerpc64-xnu/pthread_arch.h b/arch/powerpc64-xnu/pthread_arch.h
new file mode 100644
index 00000000..23135184
--- /dev/null
+++ b/arch/powerpc64-xnu/pthread_arch.h
@@ -0,0 +1,22 @@
+/* PowerPC64 Darwin uses r13 for thread-local storage pointer
+ * but for compatibility with musl's pthread implementation,
+ * we use a runtime call to get the thread pointer.
+ */
+
+static inline struct pthread *__pthread_self()
+{
+	struct pthread *self;
+	/* On Darwin PowerPC64, thread pointer is typically in r13
+	 * but may not be directly accessible. We use a function call. */
+	__asm__ __volatile__ (
+		"bl ___pthread_self_impl\n"
+		"mr %0, 3"
+		: "=r"(self)
+		:
+		: "3", "lr", "memory");
+	return self;
+}
+
+#define TP_ADJ(p) (p)
+
+#define MC_PC srr0
diff --git a/arch/powerpc64-xnu/reloc.h b/arch/powerpc64-xnu/reloc.h
new file mode 100644
index 00000000..6f90e72f
--- /dev/null
+++ b/arch/powerpc64-xnu/reloc.h
@@ -0,0 +1,42 @@
+#define LDSO_ARCH "powerpc64"
+
+/* PowerPC64 relocation types - these would normally come from elf.h
+ * but Darwin uses Mach-O, so these are placeholders for compatibility */
+#define R_PPC64_NONE          0
+#define R_PPC64_ADDR32        1
+#define R_PPC64_ADDR24        2
+#define R_PPC64_ADDR16        3
+#define R_PPC64_ADDR16_LO     4
+#define R_PPC64_ADDR16_HI     5
+#define R_PPC64_ADDR16_HA     6
+#define R_PPC64_ADDR14        7
+#define R_PPC64_REL24         10
+#define R_PPC64_REL14         11
+#define R_PPC64_ADDR64        38
+#define R_PPC64_COPY          19
+#define R_PPC64_GLOB_DAT      20
+#define R_PPC64_JMP_SLOT      21
+#define R_PPC64_RELATIVE      22
+
+#define REL_SYMBOLIC    R_PPC64_ADDR64
+#define REL_GOT         R_PPC64_GLOB_DAT
+#define REL_PLT         R_PPC64_JMP_SLOT
+#define REL_RELATIVE    R_PPC64_RELATIVE
+#define REL_COPY        R_PPC64_COPY
+
+/* Note: Darwin PowerPC64 uses Mach-O format, not ELF, so TLS relocations
+ * work differently than on Linux */
+#define REL_DTPMOD      0
+#define REL_DTPOFF      0
+#define REL_TPOFF       0
+#define REL_TLSDESC     0
+
+#define CRTJMP(pc,sp) __asm__ __volatile__( \
+	"mr 1, %1 ; mtctr %0 ; bctr" : : "r"(pc), "r"(sp) : "memory" )
+
+#define GETFUNCSYM(fp, sym, got) __asm__ ( \
+	"bl 1f\n" \
+	"1: mflr %0\n" \
+	"addis %0, %0, ha16(" #sym " - 1b)\n" \
+	"addi %0, %0, lo16(" #sym " - 1b)\n" \
+	: "=r"(*fp) : : "memory" )
diff --git a/arch/powerpc64-xnu/syscall_arch.h b/arch/powerpc64-xnu/syscall_arch.h
new file mode 100644
index 00000000..0bd47136
--- /dev/null
+++ b/arch/powerpc64-xnu/syscall_arch.h
@@ -0,0 +1,256 @@
+#define __SYSCALL_LL_E(x) (x)
+#define __SYSCALL_LL_O(x) (x)
+
+#define MACH_SYSCALL 0x1000000
+#define UNIX_SYSCALL 0x2000000
+#define ARCH_SYSCALL 0x3000000
+
+struct kern_return
+{
+	long ret;
+	long err;
+};
+
+/* PowerPC64 Darwin syscall convention:
+ * - System call number in r0 (with UNIX_SYSCALL/MACH_SYSCALL flag)
+ * - Arguments in r3-r10 (64-bit values)
+ * - sc instruction triggers syscall
+ * - Return value in r3
+ * - Carry flag (CR0[SO]) indicates error (1 = error, errno in r3)
+ * - Use bns (branch if no summary overflow) to skip negation on success
+ */
+
+static __inline long __syscall0(long n)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3");
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
