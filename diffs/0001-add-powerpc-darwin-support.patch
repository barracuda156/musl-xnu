diff --git a/arch/powerpc-xnu/atomic_arch.h b/arch/powerpc-xnu/atomic_arch.h
new file mode 100644
index 00000000..fe3d2cc8
--- /dev/null
+++ b/arch/powerpc-xnu/atomic_arch.h
@@ -0,0 +1,182 @@
+/* PowerPC atomic operations using lwarx/stwcx. instructions */
+
+#define a_cas a_cas
+static inline int a_cas(volatile int *p, int t, int s)
+{
+	int old;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	cmpw %0, %3\n"
+		"	bne- 2f\n"
+		"	stwcx. %4, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		"2:"
+		: "=&r"(old), "+m"(*p)
+		: "r"(p), "r"(t), "r"(s)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_cas_p a_cas_p
+static inline void *a_cas_p(volatile void *p, void *t, void *s)
+{
+	void *old;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	cmpw %0, %3\n"
+		"	bne- 2f\n"
+		"	stwcx. %4, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		"2:"
+		: "=&r"(old), "+m"(*(void **)p)
+		: "r"(p), "r"(t), "r"(s)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_swap a_swap
+static inline int a_swap(volatile int *p, int v)
+{
+	int old;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	stwcx. %3, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(old), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_fetch_add a_fetch_add
+static inline int a_fetch_add(volatile int *p, int v)
+{
+	int old, tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %3\n"
+		"	add %1, %0, %4\n"
+		"	stwcx. %1, 0, %3\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(old), "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_and a_and
+static inline void a_and(volatile int *p, int v)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	and %0, %0, %3\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+}
+
+#define a_or a_or
+static inline void a_or(volatile int *p, int v)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	or %0, %0, %3\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+}
+
+#define a_inc a_inc
+static inline void a_inc(volatile int *p)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	addi %0, %0, 1\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p)
+		: "cc", "memory");
+}
+
+#define a_dec a_dec
+static inline void a_dec(volatile int *p)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	addi %0, %0, -1\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p)
+		: "cc", "memory");
+}
+
+#define a_store a_store
+static inline void a_store(volatile int *p, int x)
+{
+	__asm__ __volatile__ (
+		"stw %1, %0\n"
+		"lwsync\n"
+		: "=m"(*p)
+		: "r"(x)
+		: "memory");
+}
+
+#define a_barrier a_barrier
+static inline void a_barrier()
+{
+	__asm__ __volatile__("" : : : "memory");
+}
+
+#define a_spin a_spin
+static inline void a_spin()
+{
+	/* PowerPC doesn't have a direct equivalent to x86 pause,
+	 * but we can use a simple nop or or instruction */
+	__asm__ __volatile__("or 27,27,27" : : : "memory");
+}
+
+#define a_crash a_crash
+static inline void a_crash()
+{
+	__asm__ __volatile__("trap" : : : "memory");
+}
+
+#define a_ctz_32 a_ctz_32
+static inline int a_ctz_32(uint32_t x)
+{
+	/* Count trailing zeros using negation trick and cntlzw */
+	int r;
+	__asm__("neg %0, %1\n"
+		"and %0, %0, %1\n"
+		"cntlzw %0, %0\n"
+		"subfic %0, %0, 31"
+		: "=r"(r) : "r"(x));
+	return r;
+}
+
+#define a_ctz_64 a_ctz_64
+static inline int a_ctz_64(uint64_t x)
+{
+	/* For 32-bit PowerPC, we need to handle 64-bit in two parts */
+	uint32_t lo = (uint32_t)x;
+	uint32_t hi = (uint32_t)(x >> 32);
+	if (lo) return a_ctz_32(lo);
+	return 32 + a_ctz_32(hi);
+}
