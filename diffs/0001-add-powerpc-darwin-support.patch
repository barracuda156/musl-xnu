diff --git a/src/thread/powerpc-xnu/syscall_cp.s b/src/thread/powerpc-xnu/syscall_cp.s
new file mode 100644
index 00000000..bbce72a8
--- /dev/null
+++ b/src/thread/powerpc-xnu/syscall_cp.s
@@ -0,0 +1,53 @@
+/* PowerPC Darwin syscall cancellation point
+ * long __syscall_cp_asm(volatile int *cancel_flag, long nr, ...)
+ * r3 = cancel_flag pointer
+ * r4 = syscall number
+ * r5-r10 = syscall arguments
+ */
+
+	.text
+	.align 2
+	.globl ___syscall_cp_asm
+	.globl ___cp_begin
+	.globl ___cp_end
+___syscall_cp_asm:
+	/* Check cancellation flag */
+	lwz 0, 0(3)
+	cmpwi 0, 0
+	bne- 1f
+
+	/* Setup syscall - move arguments */
+	mr 0, 4          /* syscall number to r0 */
+	mr 3, 5          /* arg1 */
+	mr 4, 6          /* arg2 */
+	mr 5, 7          /* arg3 */
+	mr 6, 8          /* arg4 */
+	mr 7, 9          /* arg5 */
+	mr 8, 10         /* arg6 */
+
+	/* Add UNIX_SYSCALL flag */
+	addis 0, 0, 0x200  /* 0x2000000 >> 16 */
+
+___cp_begin:
+	/* Make syscall */
+	sc
+
+___cp_end:
+	/* Check for error (carry flag set) */
+	bns 2f
+	neg 3, 3
+
+2:
+	blr
+
+1:
+	/* Cancellation triggered */
+	mflr 0
+	stwu 1, -16(1)
+	stw 0, 20(1)
+	bl ___cancel
+	/* Should not return */
+	lwz 0, 20(1)
+	mtlr 0
+	addi 1, 1, 16
+	blr
