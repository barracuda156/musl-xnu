@@ -0,0 +1,20 @@
+#include "stdio_impl.h"
+
+extern FILE *volatile __stdin_used;
+extern FILE *volatile __stdout_used;
+
+static void close_file(FILE *f)
+{
+	if (!f) return;
+	FFINALLOCK(f);
+	if (f->wpos > f->wbase) f->write(f, 0, 0);
+	if (f->rpos < f->rend) f->seek(f, f->rpos-f->rend, SEEK_CUR);
+}
+
+void __stdio_exit(void)
+{
+	FILE *f;
+	for (f=*__ofl_lock(); f; f=f->next) close_file(f);
+	close_file(__stdin_used);
+	close_file(__stdout_used);
+}
diff --git a/src/stdio/powerpc-xnu/__toread.c b/src/stdio/powerpc-xnu/__toread.c
new file mode 100644
index 00000000..f07a9a73
--- /dev/null
+++ b/src/stdio/powerpc-xnu/__toread.c
@@ -0,0 +1,14 @@
+#include <stdio_impl.h>
+
+int __toread(FILE *f)
+{
+	f->mode |= f->mode-1;
+	if (f->wpos > f->wbase) f->write(f, 0, 0);
+	f->wpos = f->wbase = f->wend = 0;
+	if (f->flags & F_NORD) {
+		f->flags |= F_ERR;
+		return EOF;
+	}
