+	std 0, 176(3)    /* CR */
+	mfctr 0
+	std 0, 184(3)    /* CTR */
+
+	/* Save FPRs (f14-f31) */
+	stfd 14, 192(3)
+	stfd 15, 200(3)
+	stfd 16, 208(3)
+	stfd 17, 216(3)
+	stfd 18, 224(3)
+	stfd 19, 232(3)
+	stfd 20, 240(3)
+	stfd 21, 248(3)
+	stfd 22, 256(3)
+	stfd 23, 264(3)
+	stfd 24, 272(3)
+	stfd 25, 280(3)
+	stfd 26, 288(3)
+	stfd 27, 296(3)
+	stfd 28, 304(3)
+	stfd 29, 312(3)
+	stfd 30, 320(3)
+	stfd 31, 328(3)
+
+	/* Return 0 */
+	li 3, 0
+	blr
diff --git a/src/setjmp/powerpc64-xnu/sigsetjmp.s b/src/setjmp/powerpc64-xnu/sigsetjmp.s
new file mode 100644
index 00000000..d1f01d9d
--- /dev/null
+++ b/src/setjmp/powerpc64-xnu/sigsetjmp.s
@@ -0,0 +1,36 @@
+/* PowerPC64 Darwin sigsetjmp implementation
+ * int sigsetjmp(sigjmp_buf env, int savemask)
+ * env is in r3, savemask is in r4
+ */
+
+	.text
+	.align 2
+	.globl _sigsetjmp
+	.globl __sigsetjmp
+_sigsetjmp:
+__sigsetjmp:
+	/* Save savemask flag at offset 336 */
+	std 4, 336(3)
+
+	/* If savemask is 0, just call setjmp */
+	cmpdi 4, 0
+	beq 1f
+
+	/* Save signal mask - call sigprocmask(SIG_BLOCK, NULL, &env->mask) */
+	mflr 0
+	std 0, 344(3)    /* Save LR temporarily */
+	std 3, 352(3)    /* Save env pointer */
+
+	li 3, 1          /* SIG_BLOCK */
+	li 4, 0          /* NULL */
+	ld 5, 352(3)     /* env pointer */
+	addi 5, 5, 360   /* &env->mask */
+	bl _sigprocmask
+
+	ld 3, 352(3)     /* Restore env pointer */
+	ld 0, 344(3)     /* Restore LR */
+	mtlr 0
+
+1:
+	/* Call regular setjmp */
+	b _setjmp
diff --git a/src/signal/powerpc-xnu/block.c b/src/signal/powerpc-xnu/block.c
new file mode 100644
index 00000000..43f089ff
--- /dev/null
+++ b/src/signal/powerpc-xnu/block.c
@@ -0,0 +1,43 @@
+#include "syscall.h"
+#include <signal.h>
+
+static const unsigned long all_mask[] = {
+#if ULONG_MAX == 0xffffffff && _NSIG == 129
+	-1UL, -1UL, -1UL, -1UL
+#elif ULONG_MAX == 0xffffffff
+	-1UL, -1UL
+#else
+	-1UL
+#endif
+};
+
+static const unsigned long app_mask[] = {
+#if ULONG_MAX == 0xffffffff
+#if _NSIG == 65
+	0x7fffffff, 0xfffffffc
+#else
+	0x7fffffff, 0xfffffffc, -1UL, -1UL
+#endif
+#else
+#if _NSIG == 65
+	0xfffffffc7fffffff
+#else
+	0xfffffffc7fffffff, -1UL
+#endif
+#endif
+};
+
+void __block_all_sigs(void *set)
+{
+	__syscall(SYS_sigprocmask, SIG_BLOCK, &all_mask, set, _NSIG/8);
+}
+
+void __block_app_sigs(void *set)
+{
+	__syscall(SYS_sigprocmask, SIG_BLOCK, &app_mask, set, _NSIG/8);
+}
+
+void __restore_sigs(void *set)
+{
+	__syscall(SYS_sigprocmask, SIG_SETMASK, set, 0, _NSIG/8);
+}
