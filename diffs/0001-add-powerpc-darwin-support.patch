+++ b/src/setjmp/powerpc-xnu/setjmp.s
@@ -0,0 +1,71 @@
+/* PowerPC Darwin setjmp implementation
+ * int setjmp(jmp_buf env)
+ * env is in r3
+ *
+ * Save:
+ * - GPRs r1, r2, r13-r31
+ * - FPRs f14-f31
+ * - CR, LR, CTR
+ * - Non-volatile vector registers (if AltiVec)
+ */
+
+	.text
+	.align 2
+	.globl _setjmp
+	.globl __setjmp
+_setjmp:
+__setjmp:
+	/* Save GPRs */
+	stw 1, 0(3)      /* r1 (SP) */
+	stw 2, 4(3)      /* r2 (TOC/reserved) */
+	stw 13, 8(3)     /* r13 */
+	stw 14, 12(3)    /* r14 */
+	stw 15, 16(3)    /* r15 */
+	stw 16, 20(3)    /* r16 */
+	stw 17, 24(3)    /* r17 */
+	stw 18, 28(3)    /* r18 */
+	stw 19, 32(3)    /* r19 */
+	stw 20, 36(3)    /* r20 */
+	stw 21, 40(3)    /* r21 */
+	stw 22, 44(3)    /* r22 */
+	stw 23, 48(3)    /* r23 */
+	stw 24, 52(3)    /* r24 */
+	stw 25, 56(3)    /* r25 */
+	stw 26, 60(3)    /* r26 */
+	stw 27, 64(3)    /* r27 */
+	stw 28, 68(3)    /* r28 */
+	stw 29, 72(3)    /* r29 */
+	stw 30, 76(3)    /* r30 */
+	stw 31, 80(3)    /* r31 */
+
+	/* Save special registers */
+	mflr 0
+	stw 0, 84(3)     /* LR */
+	mfcr 0
+	stw 0, 88(3)     /* CR */
+	mfctr 0
+	stw 0, 92(3)     /* CTR */
+
+	/* Save FPRs (f14-f31) */
+	stfd 14, 96(3)
+	stfd 15, 104(3)
+	stfd 16, 112(3)
+	stfd 17, 120(3)
+	stfd 18, 128(3)
+	stfd 19, 136(3)
+	stfd 20, 144(3)
+	stfd 21, 152(3)
+	stfd 22, 160(3)
+	stfd 23, 168(3)
+	stfd 24, 176(3)
+	stfd 25, 184(3)
+	stfd 26, 192(3)
+	stfd 27, 200(3)
+	stfd 28, 208(3)
+	stfd 29, 216(3)
+	stfd 30, 224(3)
+	stfd 31, 232(3)
+
+	/* Return 0 */
+	li 3, 0
+	blr
diff --git a/src/setjmp/powerpc-xnu/sigsetjmp.s b/src/setjmp/powerpc-xnu/sigsetjmp.s
new file mode 100644
index 00000000..c1b1cd26
--- /dev/null
+++ b/src/setjmp/powerpc-xnu/sigsetjmp.s
@@ -0,0 +1,36 @@
+/* PowerPC Darwin sigsetjmp implementation
+ * int sigsetjmp(sigjmp_buf env, int savemask)
+ * env is in r3, savemask is in r4
+ */
+
+	.text
+	.align 2
+	.globl _sigsetjmp
+	.globl __sigsetjmp
+_sigsetjmp:
+__sigsetjmp:
+	/* Save savemask flag at offset 240 */
+	stw 4, 240(3)
+
+	/* If savemask is 0, just call setjmp */
+	cmpwi 4, 0
+	beq 1f
+
+	/* Save signal mask - call sigprocmask(SIG_BLOCK, NULL, &env->mask) */
+	mflr 0
+	stw 0, 244(3)    /* Save LR temporarily */
+	stw 3, 248(3)    /* Save env pointer */
+
+	li 3, 1          /* SIG_BLOCK */
+	li 4, 0          /* NULL */
+	lwz 5, 248(3)    /* env pointer */
+	addi 5, 5, 252   /* &env->mask */
+	bl _sigprocmask
+
+	lwz 3, 248(3)    /* Restore env pointer */
+	lwz 0, 244(3)    /* Restore LR */
+	mtlr 0
+
+1:
+	/* Call regular setjmp */
+	b _setjmp
