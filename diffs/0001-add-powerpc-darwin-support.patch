+
+	return 0;
+}
diff --git a/src/stdio/powerpc-xnu/fclose.c b/src/stdio/powerpc-xnu/fclose.c
new file mode 100644
index 00000000..ad4e0f51
--- /dev/null
+++ b/src/stdio/powerpc-xnu/fclose.c
@@ -0,0 +1,31 @@
+#include "stdio_impl.h"
+#include "libc.h"
+
+int fclose(FILE *f)
+{
+	int r;
+	int perm;
+	
+	FLOCK(f);
+
+#if 0
+	__unlist_locked_file(f);
+#endif
+
+	if (!(perm = f->flags & F_PERM)) {
+		FILE **head = __ofl_lock();
+		if (f->prev) f->prev->next = f->next;
+		if (f->next) f->next->prev = f->prev;
+		if (*head == f) *head = f->next;
+		__ofl_unlock();
+	}
+
+	r = fflush(f);
+	r |= f->close(f);
+
+	if (f->getln_buf) free(f->getln_buf);
+	if (!perm) free(f);
+	else FUNLOCK(f);
+
+	return r;
+}
diff --git a/src/stdio/powerpc-xnu/fflush.c b/src/stdio/powerpc-xnu/fflush.c
new file mode 100644
index 00000000..1ec66028
--- /dev/null
+++ b/src/stdio/powerpc-xnu/fflush.c
@@ -0,0 +1,45 @@
+#include "stdio_impl.h"
+
+static int __fflush_unlocked(FILE *f)
+{
+	/* If writing, flush output */
+	if (f->wpos > f->wbase) {
+		f->write(f, 0, 0);
+		if (!f->wpos) return EOF;
+	}
+
+	/* If reading, sync position, per POSIX */
+	if (f->rpos < f->rend) f->seek(f, f->rpos-f->rend, SEEK_CUR);
+
+	/* Clear read and write modes */
+	f->wpos = f->wbase = f->wend = 0;
+	f->rpos = f->rend = 0;
+
+	return 0;
+}
+
+extern FILE *__stdout_used;
+
+int fflush(FILE *f)
+{
+	int r;
+
+	if (f) {
+		FLOCK(f);
+		r = __fflush_unlocked(f);
+		FUNLOCK(f);
+		return r;
+	}
+
+	r = __stdout_used ? fflush(__stdout_used) : 0;
+
+	for (f=*__ofl_lock(); f; f=f->next) {
+		FLOCK(f);
+		if (f->wpos > f->wbase) r |= __fflush_unlocked(f);
+		FUNLOCK(f);
+	}
+	__ofl_unlock();
+	
+	return r;
+}
+
