+#define REL_DTPOFF      0
+#define REL_TPOFF       0
+#define REL_TLSDESC     0
+
+#define CRTJMP(pc,sp) __asm__ __volatile__( \
+	"mr 1, %1 ; mtctr %0 ; bctr" : : "r"(pc), "r"(sp) : "memory" )
+
+#define GETFUNCSYM(fp, sym, got) __asm__ ( \
+	"bl 1f\n" \
+	"1: mflr %0\n" \
+	"addis %0, %0, ha16(" #sym " - 1b)\n" \
+	"addi %0, %0, lo16(" #sym " - 1b)\n" \
+	: "=r"(*fp) : : "memory" )
diff --git a/arch/powerpc-xnu/syscall_arch.h b/arch/powerpc-xnu/syscall_arch.h
new file mode 100644
index 00000000..d7004d89
--- /dev/null
+++ b/arch/powerpc-xnu/syscall_arch.h
@@ -0,0 +1,256 @@
+#define __SYSCALL_LL_E(x) (x)
+#define __SYSCALL_LL_O(x) (x)
+
+#define MACH_SYSCALL 0x1000000
+#define UNIX_SYSCALL 0x2000000
+#define ARCH_SYSCALL 0x3000000
+
+struct kern_return
+{
+	long ret;
+	long err;
+};
+
+/* PowerPC Darwin syscall convention:
+ * - System call number in r0 (with UNIX_SYSCALL/MACH_SYSCALL flag)
+ * - Arguments in r3-r10
+ * - sc instruction triggers syscall
+ * - Return value in r3
+ * - Carry flag (CR0[SO]) indicates error (1 = error, errno in r3)
+ * - Use bns (branch if no summary overflow) to skip negation on success
+ */
+
+static __inline long __syscall0(long n)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3");
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "=r"(r3)
+		: "r"(r0)
+		: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __syscall1(long n, long a1)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "+r"(r3)
+		: "r"(r0)
+		: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __syscall2(long n, long a1, long a2)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4)
+		: "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __syscall3(long n, long a1, long a2, long a3)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5)
+		: "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __syscall4(long n, long a1, long a2, long a3, long a4)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	register long r6 __asm__("r6") = a4;
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5), "r"(r6)
+		: "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __syscall5(long n, long a1, long a2, long a3, long a4, long a5)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	register long r6 __asm__("r6") = a4;
+	register long r7 __asm__("r7") = a5;
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5), "r"(r6), "r"(r7)
+		: "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6)
+{
+	register long r0 __asm__("r0") = UNIX_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	register long r6 __asm__("r6") = a4;
+	register long r7 __asm__("r7") = a5;
+	register long r8 __asm__("r8") = a6;
+	__asm__ __volatile__ (
+		"sc\n\t"
+		"bns 1f\n\t"
+		"neg %0, %0\n"
+		"1:"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5), "r"(r6), "r"(r7), "r"(r8)
+		: "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+/* Mach syscalls don't use carry flag for error indication */
+
+static __inline long __mach_syscall0(long n)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3");
+	__asm__ __volatile__ (
+		"sc"
+		: "=r"(r3)
+		: "r"(r0)
+		: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __mach_syscall1(long n, long a1)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	__asm__ __volatile__ (
+		"sc"
+		: "+r"(r3)
+		: "r"(r0)
+		: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __mach_syscall2(long n, long a1, long a2)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	__asm__ __volatile__ (
+		"sc"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4)
+		: "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __mach_syscall3(long n, long a1, long a2, long a3)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	__asm__ __volatile__ (
+		"sc"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5)
+		: "r6", "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __mach_syscall4(long n, long a1, long a2, long a3, long a4)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	register long r6 __asm__("r6") = a4;
+	__asm__ __volatile__ (
+		"sc"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5), "r"(r6)
+		: "r7", "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __mach_syscall5(long n, long a1, long a2, long a3, long a4, long a5)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	register long r6 __asm__("r6") = a4;
+	register long r7 __asm__("r7") = a5;
+	__asm__ __volatile__ (
+		"sc"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5), "r"(r6), "r"(r7)
+		: "r8", "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
+
+static __inline long __mach_syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6)
+{
+	register long r0 __asm__("r0") = MACH_SYSCALL + n;
+	register long r3 __asm__("r3") = a1;
+	register long r4 __asm__("r4") = a2;
+	register long r5 __asm__("r5") = a3;
+	register long r6 __asm__("r6") = a4;
+	register long r7 __asm__("r7") = a5;
+	register long r8 __asm__("r8") = a6;
+	__asm__ __volatile__ (
+		"sc"
+		: "+r"(r3)
+		: "r"(r0), "r"(r4), "r"(r5), "r"(r6), "r"(r7), "r"(r8)
+		: "r9", "r10", "r11", "r12", "cr0", "memory"
+	);
+	return r3;
+}
diff --git a/arch/powerpc64-xnu/atomic_arch.h b/arch/powerpc64-xnu/atomic_arch.h
new file mode 100644
index 00000000..41d586d6
--- /dev/null
+++ b/arch/powerpc64-xnu/atomic_arch.h
@@ -0,0 +1,202 @@
+/* PowerPC64 atomic operations using ldarx/stdcx. instructions */
+
+#define a_cas a_cas
+static inline int a_cas(volatile int *p, int t, int s)
+{
+	int old;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	cmpw %0, %3\n"
+		"	bne- 2f\n"
+		"	stwcx. %4, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		"2:"
+		: "=&r"(old), "+m"(*p)
+		: "r"(p), "r"(t), "r"(s)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_cas_p a_cas_p
+static inline void *a_cas_p(volatile void *p, void *t, void *s)
+{
+	void *old;
+	__asm__ __volatile__ (
+		"1:	ldarx %0, 0, %2\n"
+		"	cmpd %0, %3\n"
+		"	bne- 2f\n"
+		"	stdcx. %4, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		"2:"
+		: "=&r"(old), "+m"(*(void **)p)
+		: "r"(p), "r"(t), "r"(s)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_swap a_swap
+static inline int a_swap(volatile int *p, int v)
+{
+	int old;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	stwcx. %3, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(old), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_fetch_add a_fetch_add
+static inline int a_fetch_add(volatile int *p, int v)
+{
+	int old, tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %3\n"
+		"	add %1, %0, %4\n"
+		"	stwcx. %1, 0, %3\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(old), "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+	return old;
+}
+
+#define a_and a_and
+static inline void a_and(volatile int *p, int v)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	and %0, %0, %3\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+}
+
+#define a_or a_or
+static inline void a_or(volatile int *p, int v)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	or %0, %0, %3\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+}
+
+#define a_and_64 a_and_64
+static inline void a_and_64(volatile uint64_t *p, uint64_t v)
+{
+	uint64_t tmp;
+	__asm__ __volatile__ (
+		"1:	ldarx %0, 0, %2\n"
+		"	and %0, %0, %3\n"
+		"	stdcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+}
+
+#define a_or_64 a_or_64
+static inline void a_or_64(volatile uint64_t *p, uint64_t v)
+{
+	uint64_t tmp;
+	__asm__ __volatile__ (
+		"1:	ldarx %0, 0, %2\n"
+		"	or %0, %0, %3\n"
+		"	stdcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p), "r"(v)
+		: "cc", "memory");
+}
+
+#define a_inc a_inc
+static inline void a_inc(volatile int *p)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	addi %0, %0, 1\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p)
+		: "cc", "memory");
+}
+
+#define a_dec a_dec
+static inline void a_dec(volatile int *p)
+{
+	int tmp;
+	__asm__ __volatile__ (
+		"1:	lwarx %0, 0, %2\n"
+		"	addi %0, %0, -1\n"
+		"	stwcx. %0, 0, %2\n"
+		"	bne- 1b\n"
+		"	lwsync\n"
+		: "=&r"(tmp), "+m"(*p)
+		: "r"(p)
+		: "cc", "memory");
+}
+
+#define a_store a_store
+static inline void a_store(volatile int *p, int x)
+{
+	__asm__ __volatile__ (
+		"stw %1, %0\n"
+		"lwsync\n"
+		: "=m"(*p)
+		: "r"(x)
+		: "memory");
+}
+
+#define a_barrier a_barrier
+static inline void a_barrier()
+{
+	__asm__ __volatile__("" : : : "memory");
+}
+
+#define a_spin a_spin
+static inline void a_spin()
+{
+	/* PowerPC doesn't have a direct equivalent to x86 pause,
+	 * but we can use a simple nop or or instruction */
+	__asm__ __volatile__("or 27,27,27" : : : "memory");
+}
+
+#define a_crash a_crash
+static inline void a_crash()
+{
+	__asm__ __volatile__("trap" : : : "memory");
+}
+
+#define a_ctz_64 a_ctz_64
+static inline int a_ctz_64(uint64_t x)
+{
+	/* Count trailing zeros using negation trick and cntlzd (64-bit version) */
+	int r;
+	__asm__("neg %0, %1\n"
+		"and %0, %0, %1\n"
+		"cntlzd %0, %0\n"
+		"subfic %0, %0, 63"
+		: "=r"(r) : "r"(x));
+	return r;
+}
